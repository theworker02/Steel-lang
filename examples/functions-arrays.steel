// Functions & Arrays Demo - Steel Language v2.0

// === Function Definitions ===
say "=== Functions ==="

define greet as (name)
  return "Hello, " + name + "!"
end

say greet("Steel")
say greet("World")

// Function with multiple parameters
define add as (a, b)
  return a + b
end

define multiply as (a, b)
  return a * b
end

say "5 + 3 = " + add(5, 3)
say "4 * 7 = " + multiply(4, 7)

// Recursive function - Fibonacci
define fib as (n)
  if n <= 1 then
    return n
  end
  return fib(n - 1) + fib(n - 2)
end

say ""
say "=== Fibonacci ==="
for i to 12
  say "fib(" + i + ") = " + fib(i)
end

// Factorial
define factorial as (n)
  if n <= 1 then
    return 1
  end
  return n * factorial(n - 1)
end

say ""
say "=== Factorials ==="
for i to 10
  say i + "! = " + factorial(i)
end

// Function with array parameter
define sum as (arr)
  set total to 0
  for each val in arr
    set total to total + val
  end
  return total
end

define average as (arr)
  return sum(arr) / len(arr)
end

// === Array Operations ===
say ""
say "=== Array Operations ==="

set nums to [10, 20, 30, 40, 50]
say "Original: " + nums

say "Length: " + len(nums)
say "First: " + nums[0]
say "Last: " + nums[4]

// Modify array
set nums[2] to 99
say "Modified: " + nums

// Push and pop
push(nums, 60)
say "After push: " + nums

set last to pop(nums)
say "Popped: " + last
say "After pop: " + nums

// Array functions
say "Reverse: " + reverse(nums)
say "Sorted: " + sort([5, 3, 8, 1, 9, 2, 7])
say "Slice: " + slice(nums, 1, 3)
say "Includes 20: " + includes(nums, 20)
say "Includes 99: " + includes(nums, 99)

// Range function
say ""
say "=== Range ==="
set r to range(1, 6)
say "Range 1-5: " + r
say "Sum: " + sum(r)
say "Average: " + average(r)

// === Higher-order patterns ===
say ""
say "=== Map & Filter patterns ==="

define map as (arr, fnName)
  set result to []
  for each item in arr
    push(result, fnName(item))
  end
  return result
end

define filter as (arr, fnName)
  set result to []
  for each item in arr
    if fnName(item) then
      push(result, item)
    end
  end
  return result
end

define isEven as (n)
  return n % 2 == 0
end

define double as (n)
  return n * 2
end

set numbers to range(1, 11)
say "Numbers: " + numbers
say "Doubled: " + map(numbers, double)
say "Evens: " + filter(numbers, isEven)
say "Sum of 1-10: " + sum(numbers)